#!/bin/sh
# Blocks a commit that would publish private data. See scripts/scrub_check.py
#
# --staged reads the INDEX, not the working tree. Those are different files and
# the difference is exploitable: stage a secret, tidy the working copy, commit.
set -e
cd "$(git rev-parse --show-toplevel)"

# Find a working Python >= 3.12 (python3 is absent on many Windows installs;
# the Windows Store stub exists but fails the version probe, so it is skipped).
PY=
for cand in python3 python "py -3"; do
    # shellcheck disable=SC2086
    if $cand -c "import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)" >/dev/null 2>&1; then
        PY=$cand
        break
    fi
done
if [ -z "$PY" ]; then
    echo "$(basename "$0"): no working Python >= 3.12 found (tried python3, python, py -3)" >&2
    exit 1
fi
$PY scripts/scrub_check.py --staged

# Opt-in safety net for a checkout that keeps local-only tests: snapshot the
# git-ignored private layer whenever it changed since the last backup
# (scripts/private_layer.py). Enable per clone with
#     git config crucibleforge.privateBackup true
# A failed backup never blocks the commit; it only says so.
if [ "$(git config --bool crucibleforge.privateBackup 2>/dev/null)" = "true" ]; then
    $PY scripts/private_layer.py backup --if-changed --quiet \
        || echo "pre-commit: NOTE — private-layer backup failed (commit continues)" >&2
fi
exit 0
