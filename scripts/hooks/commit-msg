#!/bin/sh
# Blocks a commit MESSAGE that would publish private data.
#
# The message is published as loudly as the code, and it is where a path, a
# hostname or an assistant session URL gets pasted without thinking. It also
# enforces the "no AI-assistant trailers in the public log" rule: a
# Claude-Session: trailer additionally links a private transcript of this
# machine.
#
# Same regexes as the file scan — scrub_check.py owns them, so there is exactly
# one deny-list to keep current.
set -e
cd "$(git rev-parse --show-toplevel)"

# Find a working Python >= 3.12 (python3 is absent on many Windows installs;
# the Windows Store stub exists but fails the version probe, so it is skipped).
PY=
for cand in python3 python "py -3"; do
    # shellcheck disable=SC2086
    if $cand -c "import sys; sys.exit(0 if sys.version_info >= (3, 12) else 1)" >/dev/null 2>&1; then
        PY=$cand
        break
    fi
done
if [ -z "$PY" ]; then
    echo "$(basename "$0"): no working Python >= 3.12 found (tried python3, python, py -3)" >&2
    exit 1
fi
exec $PY scripts/scrub_check.py --message "$1"
