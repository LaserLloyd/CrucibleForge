# CrucibleForge container settings. Copy to ".env" next to compose.yml.
# Everything here is optional; the defaults below are what compose uses.
# Never commit the real .env (it is git-ignored) and keep it chmod 0600.

# --- the local LLM server, as seen from inside the container ----------------
# StudioForge / LM Studio running on the Docker host:
LLM_BASE_URL=http://host.docker.internal:1234/v1
# Used only to seed /data/models.yaml on the first start. Afterwards edit the
# providers in that file (or in the GUI).

# --- hosted providers (names must match api_key_env in models.yaml) ---------
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# --- GUI access ---------------------------------------------------------------
# A stable access token for the web GUI. Leave empty to get a fresh one in the
# container log on every start.
CRUCIBLEFORGE_GUI_TOKEN=
# Host side of the port mapping. 127.0.0.1 = this machine only.
BIND_ADDR=127.0.0.1
HOST_PORT=8777

# --- storage / limits ---------------------------------------------------------
# DATA_PATH=/srv/crucibleforge        # host dir (owned by UID 1000) instead of the named volume
TZ=UTC
MEM_LIMIT=2g
CPU_LIMIT=2.0

# --- sandbox -------------------------------------------------------------------
# 1 = the container is the sandbox for model-written code (default).
CRUCIBLEFORGE_ALLOW_UNSANDBOXED=1
