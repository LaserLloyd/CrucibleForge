# CrucibleForge Docker settings. Copy to ".env" next to compose.yaml:
#
#     cp .env.example .env
#
# then fill in only what you use. The real .env is git-ignored and never goes
# into the image; keep it private (chmod 600 .env). Every variable in .env is
# passed into the container, so the key names below must match the
# api_key_env names in /data/models.yaml.

# --- hosted APIs: fill in the one(s) you use ---------------------------------
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- a local LLM server on THIS machine ---------------------------------------
# As seen from inside the container (host.docker.internal = your machine).
# Read once, on the first start, into /data/models.yaml (provider "local").
#   llama.cpp llama-server : http://host.docker.internal:8080/v1
#   LM Studio / StudioForge: http://host.docker.internal:1234/v1
#   Ollama                 : http://host.docker.internal:11434/v1
LLM_BASE_URL=http://host.docker.internal:1234/v1
# only if your local server wants a key (then add api_key_env: LOCAL_API_KEY
# to the "local" provider in /data/models.yaml)
# LOCAL_API_KEY=

# --- results GUI (docker compose --profile gui up -d gui) ---------------------
# A stable access token; empty = a fresh one is printed in the log each start.
CRUCIBLEFORGE_GUI_TOKEN=
BIND_ADDR=127.0.0.1
HOST_PORT=8777

# --- optional ---------------------------------------------------------------
TZ=UTC
# DATA_PATH=./cf-data        # a host folder instead of the named volume (Podman + SELinux: see docs)
# RUN_AS=1000:1000           # container user; match the owner of DATA_PATH
