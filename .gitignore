# local config (holds your endpoints; API keys must stay in env vars anyway)
models.yaml
# outputs
results/
# hand-written scratch run scorecards (distinct from the run-report
# directory set by $CRUCIBLEFORGE_V2_RUNS_ROOT). Never tracked, same as results/.
runs/
*.log
# python
.venv/
__pycache__/
*.pyc
.pytest_cache/
dist/
build/
*.egg-info/
# editors
.idea/
.vscode/
# the private-identifier list for scripts/scrub_check.py: it necessarily
# CONTAINS the words that must never be published, so it never ships
scripts/scrub-rules.local.txt
run_*.sh
models.yaml.bak*
# local scheduled-bench scratch (holds rig addresses + home paths)
.scheduled/
# PRIVATE benchmark content — local only, never published (README "Private
# categories"). scripts/scrub_check.py refuses these paths even if forced in.
cases/private/
profiles/private/
profiles/*.private.yaml
# operator batch/campaign launchers (rig model lists, home paths)
scripts/bench-*-batch.sh
